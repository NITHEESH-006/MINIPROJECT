<section class="" style="padding-top: 150px; padding-bottom: 200px;">

<h1 class="text-success text-center">
    LOGIN
</h1>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form method="post" action="/users/login">
                    {{#if loginErr}}
                        <p class="error text-danger text-center">{{loginErr}} </p>
                    {{/if}}
                        <div class="form-group">
                            <label for="Email">
                                Email
                            </label>
                            <input type="email" 
                                   class="form-control" 
                                   id="Email" 
                                   name="Email"        
                                   placeholder="Email" required />
                        </div>
                        <div class="form-group">
                            <label for="Password">
                                Password
                            </label>
                            <input type="password" 
                                   class="form-control" 
                                   id="Password" 
                                   name="Password"     
                                   placeholder="Password" required />
                        </div>
                        <button type="submit" class="btn btn-primary float-end">
                            Login
                        </button>
                    </form>
                    <p class="mt-3">
                        Not registered?
                        <a href="/users/signup">Create an
                            account</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
</section>

