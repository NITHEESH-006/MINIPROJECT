<section style="padding-top: 150px; padding-bottom: 450px;">
  <div class="container">


<h2>Search Results for "{{query}}"</h2>

{{#if articles.length}}
  <ul>
    {{#each articles}}
      <li>
        <a href="/users/article/{{this._id}}" style="text-decoration: none;">
        <h3>{{this.title}}</h3>
         <img src="/images/{{this._id}}.jpg" class="card-img-top" style="height: 200px;width:500px" alt="{{this.title}}">
        
        </a>
      </li>
    {{/each}}
    
  </ul>
{{else}}
  <p>No articles or videos found.</p>
{{/if}}

  </div>
</section> 
