    <div class="row align-items-center">
        <div class="logo col-md-6">
            <img src="images/logo1.png" class="img-fluid">
        </div>
        
        <div class="menu align-items-center pt-5 col-md-6">  
       



            <!--chatgpt responsive version-->
            <section class="carousel">
              <div class="container">
                <div class="row justify-content-center carousel__container">  
            
                  
                  <div class="col-12 col-sm-6 col-md-4 mb-3 px-2">  
                    <a href="/users/cricket-news" class="text-decoration-none d-block"> 
                      <div class="carousel-item text-center w-100">  
